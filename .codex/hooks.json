{
  "hooks": {
    "SessionStart": [{"hooks": [{"type": "command", "command": "python3 scripts/wiki_first_hook.py start --cli codex", "timeout": 10}]}],
    "PreToolUse": [{"matcher": "Bash|apply_patch|Edit|Write", "hooks": [{"type": "command", "command": "python3 scripts/wiki_first_hook.py pre --cli codex", "timeout": 10}]}],
    "Stop": [{"hooks": [{"type": "command", "command": "python3 scripts/wiki_first_hook.py stop --cli codex", "timeout": 10}]}]
  }
}
